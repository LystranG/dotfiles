# : Manager [[[

[mgr]
cwd = { fg = "#e4e2e3" }

# Tab
tab_active = { fg = "#28313b", bg = "#bec7d4", bold = true }
tab_inactive = { fg = "#dae3f1", bg = "#131c26" }
tab_width = 1

# Find
find_keyword = { fg = "#ffb4ab", bold = true, italic = true, underline = true }
find_position = { fg = "#ffb4ab", bold = true, italic = true }

# Marker
marker_copied = { fg = "#7fade7", bg = "#7fade7" }
marker_cut = { fg = "#d5e4f7", bg = "#d5e4f7" }
marker_marked = { fg = "#ffb4ab", bg = "#ffb4ab" }
marker_selected = { fg = "#b9c8da", bg = "#b9c8da" }

# Count
count_copied = { fg = "#0e1d2a", bg = "#d5e4f7" }
count_cut = { fg = "#0e1d2a", bg = "#d5e4f7" }
count_selected = { fg = "#28313b", bg = "#b9c8da" }

# Border
border_symbol = "│"
border_style  = { fg = "#bec7d4" }

# : ]]]


# : Status [[[

[status]
separator_open = "🭁"
separator_close = "🭠"
separator_style = { bg = "#28313b", fg = "#F4A261" }

[mode]
# Mode
normal_main = { bg = "#bec7d4", fg = "#28313b", bold = true }
normal_alt  = { bg = "#474748", fg = "#c8c6c7" }

# Select mode
select_main = { bg = "#c2c7cf", fg = "#2c3137", bold = true }
select_alt  = { bg = "#474748", fg = "#c8c6c7" }

# Unset mode
unset_main = { bg = "#b9c8da", fg = "#243240", bold = true }
unset_alt  = { bg = "#474748", fg = "#c8c6c7" }

# Progress
progress_label = { bold = true }
progress_normal = { fg = "#bec7d4", bg = "#39393a" }
progress_error = { fg = "#ffb4ab", bg = "#39393a" }

# Permissions
permissions_t = { fg = "#6d798b" }
permissions_w = { fg = "#5679a4" }
permissions_x = { fg = "#ff2b12" }
permissions_r = { fg = "#5491df" }
permissions_s = { fg = "#6b8fc7" }

# : ]]]


# : Select [[[

[select]
border = { fg = "#bec7d4" }
active = { fg = "#b9c8da", bold = true }

# : ]]]


# : Input [[[

[input]
border = { fg = "#bec7d4" }
value = { fg = "#e4e2e3" }

# : ]]]

# : Tabs [[[

[tabs]
active = { fg = "#bec7d4", bold = true, bg = "#131314" }
inactive = { fg = "#c2c7cf", bg = "#131314" }
sep_inner = { open = "[", close = "]" }

# : ]]]


# : Completion [[[

[completion]
border = { fg = "#bec7d4", bg = "#28313b" }

# : ]]]


# : Tasks [[[

[tasks]
border = { fg = "#bec7d4" }
title = {}
hovered = { fg = "#d5e4f7", underline = true }

# : ]]]


# : Which [[[

[which]
cols = 3
mask = { bg = "#39393a" }
cand = { fg = "#bec7d4" }
rest = { fg = "#28313b" }
desc = { fg = "#e4e2e3" }
separator = " ▶ "
separator_style = { fg = "#e4e2e3" }

# : ]]]


# : Help [[[

[help]
on = { fg = "#e4e2e3" }
run = { fg = "#e4e2e3" }
footer = { fg = "#2c3137", bg = "#c2c7cf" }

# : ]]]


# : Notify [[[

[notify]
title_info = { fg = "#b9c8da" }
title_warn = { fg = "#bec7d4" }
title_error = { fg = "#ffb4ab" }

# : ]]]


# : File-specific styles [[[

[filetype]

rules = [
    # Images
    { mime = "image/*", fg = "#94e2d5" },

    # Media
    { mime = "{audio,video}/*", fg = "#f9e2af" },

    # Archives
    { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#f5c2e7" },

    # Documents
    { mime = "application/{pdf,doc,rtf}", fg = "#a6e3a1" },

    # Special files
    { name = "*", is = "orphan", bg = "#93000a" },
    { name = "*", is = "exec", fg = "#ffdad6" },

    # Fallback
    { name = "*", fg = "#e4e2e3" },
    { name = "*/", fg = "#bec7d4" },
]

# : ]]]
