{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ],
      "lifecycle": "keep-alive",
      "directTools": [
        "replace_content",
        "replace_in_files",
        "replace_symbol_body",
        "insert_after_symbol",
        "insert_before_symbol",
        "search_for_pattern",
        "onboarding",
        "initial_instructions",
        "serena_info",
        "jet_brains_find_symbol",
        "jet_brains_move",
        "jet_brains_safe_delete",
        "jet_brains_inline_symbol",
        "jet_brains_find_referencing_symbols",
        "jet_brains_get_symbols_overview",
        "jet_brains_type_hierarchy",
        "jet_brains_find_declaration",
        "jet_brains_find_implementations",
        "jet_brains_rename",
        "jet_brains_run_inspections",
        "jet_brains_list_inspections"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        {{ (bitwardenFields "item" "api-keys").context7.value | toJson }}
      ],
      "directTools": true,
      "requestTimeoutMs": 30000
    },
    "idea-mcp": {
      "url": "http://127.0.0.1:64342/stream",
      "directTools": false
    }
  }
}
